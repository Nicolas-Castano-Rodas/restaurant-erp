generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  users      User[]
  roles      Role[]
  categories Category[]
  products   Product[]
  customers  Customer[]
  tables     RestaurantTable[]
  orders     Order[]
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  address        String?
  phone          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  orders       Order[]
  tables       RestaurantTable[]

  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  organizationId String
  branchId       String?
  roleId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([organizationId])
  @@index([branchId])
  @@index([roleId])
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  sku            String?
  imageUrl       String?
  cost           Decimal  @db.Decimal(12, 2)
  price          Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  available      Boolean  @default(true)
  organizationId String
  categoryId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, active])
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

model RestaurantTable {
  id             String      @id @default(cuid())
  name           String
  number         Int
  capacity       Int?
  status         TableStatus @default(AVAILABLE)
  organizationId String
  branchId       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([branchId, number])
  @@index([organizationId])
  @@index([branchId])
  @@index([branchId, status])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   Int
  type          OrderType
  status        OrderStatus   @default(PENDING)
  kitchenStatus KitchenStatus @default(PENDING)

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  notes String?

  organizationId String
  branchId       String
  userId         String
  customerId     String?
  tableId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([branchId, orderNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
  @@index([customerId])
  @@index([tableId])
  @@index([branchId, status])
  @@index([branchId, kitchenStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  notes     String?

  orderId   String
  productId String
  variantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}