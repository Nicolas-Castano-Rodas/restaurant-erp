generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  currency    String       @default("COP") @db.VarChar(3)
  timeZone    String       @default("America/Bogota")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branches    Branch[]
  roles       Role[]
  memberships Membership[]
  categories  Category[]
  products    Product[]
  ingredients Ingredient[]
}

model Branch {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String
  code           String
  address        String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    MembershipBranch[]
  tables         RestaurantTable[]
  orders         Order[]
  cashShifts     CashShift[]
  inventoryBalances InventoryBalance[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Permission {
  code        String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId         String     @db.Uuid
  permissionCode String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
}

model Membership {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  userId         String             @db.Uuid
  roleId         String             @db.Uuid
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role               @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  branches       MembershipBranch[]
  orders         Order[]
  openedShifts   CashShift[] @relation("ShiftOpenedBy")
  closedShifts   CashShift[] @relation("ShiftClosedBy")
  payments       Payment[]
  closedOrders   Order[] @relation("OrderClosedBy")
  stockMovements StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, roleId])
}

model MembershipBranch {
  organizationId String     @db.Uuid
  membershipId   String     @db.Uuid
  branchId       String     @db.Uuid
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  branch         Branch     @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, branchId])
  @@index([organizationId, membershipId])
  @@index([organizationId, branchId])
}

model Session {
  tokenHash    String   @id @db.VarChar(64)
  userId       String   @db.Uuid
  membershipId String?  @db.Uuid
  branchId     String?  @db.Uuid
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id @db.VarChar(64)
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  categoryId     String           @db.Uuid
  name           String
  description    String?
  price          Decimal          @db.Decimal(12, 2)
  active         Boolean          @default(true)
  available      Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       Category         @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  variants       ProductVariant[]
  orderLines     OrderLine[]
  recipeLines    RecipeLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, categoryId])
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  name           String
  price          Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  orderLines     OrderLine[]
  recipeLines    RecipeLine[]

  @@unique([organizationId, productId, id])
  @@unique([organizationId, productId, name])
  @@unique([organizationId, id])
  @@index([organizationId, productId])
}

model RestaurantTable {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  name           String
  capacity       Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  orders         Order[]

  @@unique([organizationId, branchId, id])
  @@unique([organizationId, branchId, name])
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Order {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId       String @db.Uuid
  membershipId   String @db.Uuid
  tableId        String? @db.Uuid
  tableName      String?
  requestId      String @db.Uuid
  requestHash    String @db.VarChar(64)
  channel        OrderChannel
  status         OrderStatus @default(OPEN)
  kitchenStatus  KitchenStatus @default(PENDING)
  preparingAt    DateTime?
  readyAt        DateTime?
  servedAt       DateTime?
  closedAt       DateTime?
  closedById     String? @db.Uuid
  cancelReason   String?
  currency       String @db.VarChar(3)
  subtotal       Decimal @db.Decimal(16, 2)
  discount       Decimal @default(0) @db.Decimal(16, 2)
  tax            Decimal @default(0) @db.Decimal(16, 2)
  total          Decimal @db.Decimal(16, 2)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  table          RestaurantTable? @relation(fields: [organizationId, branchId, tableId], references: [organizationId, branchId, id], onDelete: Restrict)
  lines          OrderLine[]
  stockMovements StockMovement[]
  payment        Payment?
  closedBy       Membership? @relation("OrderClosedBy", fields: [organizationId, closedById], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, id])
  @@unique([organizationId, branchId, requestId])
  @@index([organizationId, branchId, status, createdAt])
  @@index([organizationId, branchId, kitchenStatus, createdAt])
}

model OrderLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  orderId        String @db.Uuid
  productId      String @db.Uuid
  variantId      String? @db.Uuid
  productName    String
  variantName    String?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(16, 2)
  order          Order @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  product        Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [organizationId, productId, variantId], references: [organizationId, productId, id], onDelete: Restrict)

  @@index([organizationId, orderId])
  @@index([organizationId, productId, variantId])
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model CashShift {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId       String @db.Uuid
  openedById     String @db.Uuid
  closedById     String? @db.Uuid
  currency       String @db.VarChar(3)
  status         CashShiftStatus @default(OPEN)
  openingAmount  Decimal @db.Decimal(16, 2)
  expectedAmount Decimal? @db.Decimal(16, 2)
  countedAmount  Decimal? @db.Decimal(16, 2)
  difference     Decimal? @db.Decimal(16, 2)
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  branch         Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  openedBy       Membership @relation("ShiftOpenedBy", fields: [organizationId, openedById], references: [organizationId, id], onDelete: Restrict)
  closedBy       Membership? @relation("ShiftClosedBy", fields: [organizationId, closedById], references: [organizationId, id], onDelete: Restrict)
  payments       Payment[]

  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, status, openedAt])
}

model Payment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId       String @db.Uuid
  orderId        String @db.Uuid
  shiftId        String @db.Uuid
  membershipId   String @db.Uuid
  method         PaymentMethod
  currency       String @db.VarChar(3)
  amount         Decimal @db.Decimal(16, 2)
  received       Decimal @db.Decimal(16, 2)
  change         Decimal @db.Decimal(16, 2)
  createdAt      DateTime @default(now())
  order          Order @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)
  shift          CashShift @relation(fields: [organizationId, branchId, shiftId], references: [organizationId, branchId, id], onDelete: Restrict)
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, orderId])
  @@index([organizationId, branchId, shiftId])
}

enum IngredientUnit {
  KG
  G
  L
  ML
  UNIT
}

enum StockMovementKind {
  ENTRY
  EXIT
  WASTE
}

model Ingredient {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  unit           IngredientUnit
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balances       InventoryBalance[]
  recipeLines    RecipeLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model InventoryBalance {
  organizationId String @db.Uuid
  branchId       String @db.Uuid
  ingredientId   String @db.Uuid
  quantity       Decimal @default(0) @db.Decimal(16, 3)
  minimum        Decimal @default(0) @db.Decimal(16, 3)
  unitCost       Decimal? @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
  branch         Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  ingredient     Ingredient @relation(fields: [organizationId, ingredientId], references: [organizationId, id], onDelete: Restrict)
  movements      StockMovement[]

  @@id([organizationId, branchId, ingredientId])
}

model StockMovement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId       String @db.Uuid
  ingredientId   String @db.Uuid
  membershipId   String @db.Uuid
  requestId      String @db.Uuid
  kind           StockMovementKind
  quantity       Decimal @db.Decimal(16, 3)
  balanceAfter   Decimal @db.Decimal(16, 3)
  reason         String
  orderId        String? @db.Uuid
  unitCost       Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  balance        InventoryBalance @relation(fields: [organizationId, branchId, ingredientId], references: [organizationId, branchId, ingredientId], onDelete: Restrict)
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  order          Order? @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, requestId])
  @@unique([organizationId, branchId, orderId, ingredientId])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, branchId, ingredientId])
}

model RecipeLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  productId      String @db.Uuid
  variantId      String? @db.Uuid
  ingredientId   String @db.Uuid
  quantity       Decimal @db.Decimal(16, 3)
  product        Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [organizationId, productId, variantId], references: [organizationId, productId, id], onDelete: Restrict)
  ingredient     Ingredient @relation(fields: [organizationId, ingredientId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, productId, variantId, ingredientId])
  @@index([organizationId, ingredientId])
}
