{
  "name": "restaurant-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/ensure-prisma.mjs",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test": "tsx tests/integration/tenant-integrity.ts",
    "auth:provision": "tsx scripts/provision-owner.ts",
    "auth:test": "tsx tests/integration/auth.ts",
    "auth:cleanup": "tsx scripts/cleanup-auth.ts",
    "catalog:test": "tsx tests/integration/catalog.ts",
    "orders:test": "tsx tests/integration/orders.ts",
    "dev:clean": "node scripts/clean-next.mjs && npm run dev",
    "kitchen:test": "tsx tests/integration/kitchen.ts",
    "cash:test": "tsx tests/integration/cash.ts",
    "inventory:test": "tsx tests/integration/inventory.ts",
    "recipes:test": "tsx tests/integration/recipes.ts",
    "purchases:test": "tsx tests/integration/purchases.ts",
    "analytics:test": "tsx tests/integration/analytics.ts",
    "team:test": "tsx tests/integration/team.ts",
    "ui:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "production:check": "node --env-file-if-exists=.env scripts/check-production.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.10.3",
    "postcss": "^8.5.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@prisma/config": {
      "effect": "^3.22.1"
    }
  }
}
