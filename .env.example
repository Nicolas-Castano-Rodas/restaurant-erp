# Local development only. Replace placeholders before use.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://restaurant_user:replace_me@localhost:5432/restaurant_erp_dev?schema=public

# Enable only when production is served exclusively through verified HTTPS.
ENABLE_HSTS=false

# Hosted database only: trusted provider CA in PEM form (server-side only).
# With this variable, DATABASE_URL must specify sslmode=verify-full.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
